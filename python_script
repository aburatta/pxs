import csv
import os
import sys
from pathlib import Path

# ---------- EDIT THESE SETTINGS ----------
API_DIR = Path(r"C:\Program Files\Energy Exemplar\PLEXOS 12.0")

SOLUTION_PATH = Path(
    r"J:\DATA\WF\Power Marketing & Planning\Planning\Nassar\Python Tool Test Folder"
    r"\Plexos Solutions\69965\Model WE - T2 Case 155 F1 Solution.zip"
)

OUTPUT_CSV = Path(
    r"J:\DATA\WF\Power Marketing & Planning\Planning\Nassar\Python Tool Test Folder"
    r"\Plexos Solutions\69965\generator_results.csv"
)

COLLECTION_KEY = "SystemGenerators"
PARENT_NAME = ""
CHILD_NAME = ""
PHASE_NAME = "STSchedule"
PERIOD_NAME = "Interval"
SERIES_NAME = "Properties"
# ----------------------------------------


def load_plexos_api():
    if not API_DIR.is_dir():
        raise FileNotFoundError(
            f"PLEXOS API folder was not found: {API_DIR}"
        )

    if not SOLUTION_PATH.is_file():
        raise FileNotFoundError(
            f"Solution ZIP was not found: {SOLUTION_PATH}"
        )

    sys.path.insert(0, str(API_DIR))
    os.add_dll_directory(str(API_DIR))

    from pythonnet import load
    load("coreclr")

    import clr

    assembly_files = (
        "EEUTILITY.dll",
        "EEDataFactory.dll",
        "EnergyExemplar.PLEXOS.Utility.dll",
        "PLEXOS_NET.Core.dll",
    )

    for assembly_file in assembly_files:
        assembly_path = API_DIR / assembly_file

        if not assembly_path.is_file():
            raise FileNotFoundError(
                f"Required PLEXOS API DLL was not found: {assembly_path}"
            )

        clr.AddReference(str(assembly_path))

    from PLEXOS_NET.Core import Solution
    from EEUTILITY.Enums import SimulationPhaseEnum
    from EnergyExemplar.PLEXOS.Utility.Enums import (
        PeriodEnum,
        SeriesTypeEnum,
    )

    return Solution, SimulationPhaseEnum, PeriodEnum, SeriesTypeEnum


def public_properties(row):
    result = {}

    for prop in row.GetType().GetProperties():
        if prop.CanRead and prop.GetIndexParameters().Length == 0:
            value = prop.GetValue(row, None)
            result[prop.Name] = "" if value is None else str(value)

    return result


def main():
    Solution, SimulationPhaseEnum, PeriodEnum, SeriesTypeEnum = load_plexos_api()
    solution = None

    try:
        solution = Solution()
        solution.Connection(str(SOLUTION_PATH))

        collection_ids = solution.FetchAllCollectionIds()

        if not collection_ids.ContainsKey(COLLECTION_KEY):
            available = sorted(str(key) for key in collection_ids.Keys)

            raise KeyError(
                f"Collection '{COLLECTION_KEY}' is not available.\n\n"
                + "Available collection keys:\n"
                + "\n".join(available)
            )

        rows = list(
            solution.QueryToList(
                getattr(SimulationPhaseEnum, PHASE_NAME),
                collection_ids[COLLECTION_KEY],
                PARENT_NAME,
                CHILD_NAME,
                getattr(PeriodEnum, PERIOD_NAME),
                getattr(SeriesTypeEnum, SERIES_NAME),
            )
        )

        records = [public_properties(row) for row in rows]
        columns = sorted(
            {column for record in records for column in record}
        )

        OUTPUT_CSV.parent.mkdir(parents=True, exist_ok=True)

        with OUTPUT_CSV.open(
            "w",
            newline="",
            encoding="utf-8-sig",
        ) as file:
            writer = csv.DictWriter(file, fieldnames=columns)
            writer.writeheader()
            writer.writerows(records)

        print(f"Retrieved {len(records)} row(s).")
        print(f"CSV created: {OUTPUT_CSV}")

    finally:
        if solution is not None:
            solution.Close()


if __name__ == "__main__":
    main()
